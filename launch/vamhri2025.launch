<launch>

    <include file="$(find ros_tcp_endpoint)/launch/endpoint.launch" />
   <include file="$(find fetch_moveit_config)/launch/move_group.launch" /> 
    
    <node name="descriptionpublisher" pkg="fetch_vr_backend" type="republish_description.py" />
    <node name="publish_tf" pkg="fetch_vr_backend" type="republish_tf.py" />

    <node name="image_throttle" pkg="topic_tools" type="throttle" args="messages /head_camera/rgb/image_raw/compressed 10.0" />
    <!--<node name="cloud_throttle" pkg="topic_tools" type="throttle" args="messages /head_camera/depth_registered/points 0.5" /> -->
    <node name="cloud_throttle" pkg="topic_tools" type="throttle" args="messages /head_camera/depth_downsample/points 0.5 /head_camera/depth_registered/points_throttle" />

    <node name="waypoint_node" pkg="fetch_vr_backend" type="waypoint_node" />
    <node name="gripper_node" pkg="fetch_vr_backend" type="gripper_node" />
    <!-- <node name="direct_control_node" pkg="fetch_vr_backend" type="direct_control_node" /> -->
    <!-- <node name="nav_node" pkg="fetch_vr_backend" type="nav_node" /> -->
    <node name="nav_plan_node" pkg="fetch_vr_backend" type="nav_plan_node" />
    <node name="arm_command_node" pkg="fetch_vr_backend" type="arm_command_node" />
    <node name="head_command_node" pkg="fetch_vr_backend" type="head_command_node" />
    <node name="torso_command_node" pkg="fetch_vr_backend" type="torso_command_node" />


    <include file="$(find fetch_vr_backend)/launch/include/navigation.launch">
        <arg name="mapfile" value="$(find fetch_vr_backend)/maps/vr-experiment/latest.yaml" />
    </include>

</launch>
